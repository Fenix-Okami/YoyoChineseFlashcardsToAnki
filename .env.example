# Copy this file to `.env` and fill in your values.
# IMPORTANT: keep your cookie private; `.env` is gitignored.

# Required
YOYO_COOKIE="PASTE_COOKIE_HEADER_VALUE_HERE"

# Extract step defaults
YOYO_DECK_NAME="YoYoChinese"
YOYO_OUTPUT="export"
YOYO_PER_PAGE=50
# YOYO_MAX_CARDS=100
YOYO_DELAY=0.2
YOYO_MASTERY_TYPE="all"
# YOYO_COURSE_ID=""
# YOYO_LEVEL_ID=""
# YOYO_UNIT_ID=""
# YOYO_LESSON_ID=""
YOYO_SPLIT_BY_WORDTYPE=false
YOYO_LEVELS_SUBDECKS=false
YOYO_AUDIO_WORKERS=8

# Load step (optional)
# YOYO_APKG_PATH=""
